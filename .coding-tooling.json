{
  "schemaVersion": 1,
  "profile": "repository-foundation-v1",
  "tiers": {
    "fast": ["format:check", "lint", "typecheck", "build", "test:unit"],
    "browser": ["test:e2e", "test:visual", "test:accessibility"],
    "full": [
      "format:check",
      "lint",
      "typecheck",
      "build",
      "test:unit",
      "test:e2e",
      "test:visual",
      "test:accessibility",
      "storybook:check",
      "package:check",
      "dependencies:audit",
      "web:audit"
    ],
    "release": [
      "format:check",
      "lint",
      "typecheck",
      "build",
      "test:unit",
      "test:integration",
      "test:e2e",
      "test:visual",
      "test:accessibility",
      "storybook:check",
      "package:check",
      "dependencies:audit",
      "web:audit",
      "benchmark:smoke"
    ]
  },
  "requiredCapabilities": ["format:check", "lint", "typecheck", "build", "test:unit"],
  "optionalCapabilities": [
    "test:integration",
    "test:e2e",
    "test:visual",
    "test:accessibility",
    "storybook:check",
    "package:check",
    "dependencies:audit",
    "web:audit",
    "benchmark:smoke"
  ],
  "capabilityCommands": {
    "@moritzbrantner/charts": {
      "format:check": ["bun", "run", "format:check"],
      "lint": ["bun", "run", "lint"],
      "typecheck": ["bun", "run", "check-types"],
      "build": ["bun", "run", "build"],
      "test:unit": ["bun", "run", "test:coverage"],
      "test:integration": ["bun", "run", "test:wasm"],
      "test:e2e": ["bun", "run", "test:e2e"],
      "test:visual": ["bun", "run", "test:visual"],
      "test:accessibility": ["bun", "run", "test:storybook"],
      "storybook:check": ["bun", "run", "build:storybook"],
      "package:check": ["bun", "run", "pack:check"],
      "dependencies:audit": ["bun", "run", "audit:production"],
      "web:audit": ["bun", "run", "test:unlighthouse"],
      "benchmark:smoke": ["bun", "run", "bench:large-data"]
    }
  }
}
