{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts"],
  "out": "docs",
  "readme": "README.md",
  "tsconfig": "tsconfig.json",
  "cleanOutputDir": true,
  "excludeInternal": true,
  "excludePrivate": true,
  "hideGenerator": true,
  "intentionallyNotExported": [
    "BinnedSeries",
    "BinnedSeriesBin",
    "BinnedSeriesIndexOptions",
    "BinnedSeriesQuery",
    "BinnedSeriesSummary",
    "DataDensityMetricRecord",
    "DataDensityViewportSummary",
    "IndexedNumericSeriesPoint",
    "NumericSeriesPoint"
  ],
  "includeVersion": true,
  "navigationLinks": {
    "GitHub": "https://github.com/moritzbrantner/charts"
  }
}
